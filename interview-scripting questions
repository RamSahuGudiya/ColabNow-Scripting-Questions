function updateWorkNotes(problemId, worknotes) {
    var gr = new GlideRecord('problem');
    gr.addQuery('sys_id', problemId);
    gr.query();


    if (gr.next()) {
        gr.work_notes = worknotes;
        gr.update();
    }
}






